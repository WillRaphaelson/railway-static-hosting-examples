{
	admin off
	auto_https off
	persist_config off
}
:{$PORT:8080} {
	encode zstd gzip
	header X-Content-Type-Options nosniff
	root * {$STATIC_ROOT:/app/dist}
	handle /health {
		respond "ok" 200
	}
	handle /api/* {
		reverse_proxy {$API_HOST:localhost}:{$API_PORT:3000}
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
